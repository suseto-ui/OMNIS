# GEMINI_API_KEY: Primary Gemini AI API key from AI Studio Secrets
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY1=YOUR_GEMINI_API_KEY1
GEMINI_KEY_1=YOUR_GEMINI_KEY_1

# GEMINI_API_KEY_2: Secondary fallback Gemini API key for automatic rotation
GEMINI_API_KEY_2=YOUR_GEMINI_API_KEY_2
GEMINI_API_KEY2=YOUR_GEMINI_API_KEY2
GEMINI_KEY_2=YOUR_GEMINI_KEY_2

# GEMINI_API_KEY_3: Tertiary fallback Gemini API key for automatic rotation
GEMINI_API_KEY_3=YOUR_GEMINI_API_KEY_3
GEMINI_API_KEY3=YOUR_GEMINI_API_KEY3
GEMINI_KEY_3=YOUR_GEMINI_KEY_3

# Local development can use the Docker Compose PostgreSQL service.
# For Cloud SQL, use the private IP and URL-encode special characters in the password.
DATABASE_URL=postgresql+asyncpg://omnis_user:your-secure-database-password@10.59.64.3:5432/omnis_db
